# Cloudflare Pages response headers
# Images and video: cache for 30 days in browsers, 1 year at Cloudflare's edge.
# If you replace a file but keep the same name, rename it (e.g. add -v2) so visitors get the new one.
/assets/*
  Cache-Control: public, max-age=2592000, s-maxage=31536000, stale-while-revalidate=86400

# Fonts never change
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Styles and scripts: always check for a fresh copy, so edits show up right away
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Pages: always check for a fresh copy
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
